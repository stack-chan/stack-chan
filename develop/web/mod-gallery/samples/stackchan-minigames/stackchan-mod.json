  "source": {
    "path": "miniapp/manifest.json"
  },
  "entrypoints": ["miniapp"],
  "targets": ["m5stackchan-cores3", "simulator"],
  "capabilities": [],
  "artifacts": [
    {
      "format": "xsa",
      "path": "stackchan-minigames.xsa",
      "target": "m5stackchan-cores3"
    }
  ]
}
