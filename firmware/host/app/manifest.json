{
  "build": {
    "NAME": "stack-chan-host"
  },
  "defines": {
    "XS_MODS": 1
  },
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODULES)/base/modules/manifest.json",
    "$(MODULES)/data/crc/manifest.json",
    "../modules/motion/manifest.json",
    "../modules/audio/manifest.json",
    "../modules/connectivity/manifest.json",
    "../modules/conversation/manifest.json",
    "../modules/camera/manifest.json",
    "../modules/lighting/manifest.json",
    "../modules/ui/manifest.json",
    "../modules/input/manifest.json",
    "../modules/util/manifest.json",
    "../modules/preferences/manifest.json",
    "../platforms/esp32/manifest.json",
    "../platforms/lin/manifest.json",
    "./manifest_typings.json"
  ],
  "modules": {
    "*": [
      "./main",
      "./app-behavior",
      "./app-behavior-resolver",
      "./boot-network-recovery",
      "./boot-services",
      "./compose",
      "./capabilities",
      "./setup-mode",
      "./settings-status",
      "./runtime-audio",
      "./runtime-camera",
      "./runtime-context",
      "./runtime-input",
      "./runtime-lighting",
      "./runtime-ui",
      "$(MODULES)/network/http/*"
    ],
    "startup-splash": "../modules/ui/views/splash/splash-view",
    "camera-preview": "../modules/ui/views/camera-preview/camera-preview-view",
    "camera-preview-utils": "../modules/ui/views/camera-preview/camera-preview-utils",
    "app-behavior": "./app-behavior",
    "app-default-behavior": "./default-behavior/behavior",
    "app-default-behavior/on-context-created": "./default-behavior/on-context-created",
    "app-default-behavior/on-launch": "./default-behavior/on-launch",
    "app-default-behavior/startup-choice": "./default-behavior/startup-choice"
  },
  "preload": [
    "runtime-context",
    "touch",
    "touch-panel",
    "touch-panel-gesture",
    "imu",
    "imu-motion",
    "speaker"
  ],
  "strip": [],
  "config": {
    "sntp": "pool.ntp.org",
    "driver": {
      "panId": 1,
      "tiltId": 2,
      "pwmPan": 5,
      "pwmTilt": 2,
      "offsetTilt": 0,
      "offsetPan": 0
    },
    "serial": {
      "transmit": 17,
      "receive": 16
    },
    "enablePowerButton": true
  },
  "resources": {
    "*": ["./strings/*"],
    "*-mask": ["$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-24"],
    "*-alpha": [
      {
        "source": "../modules/ui/assets/fonts/k8x12",
        "size": 12,
        "characterFiles": "../modules/ui/assets/fonts/k8x12-chars.txt",
        "localization": true,
        "monochrome": true
      },
      {
        "source": "../modules/ui/assets/fonts/StackchanCJK-Regular",
        "name": "StackchanCJK",
        "size": 12,
        "characters": " ",
        "blocks": [],
        "localization": true,
        "monochrome": true
      },
      {
        "source": "../modules/ui/assets/fonts/k8x12",
        "size": 24,
        "characters": "Stack-chan[・＿・]",
        "monochrome": true
      }
    ]
  },
  "bundle": {
    "id": "tech.moddable.stackchan",
    "devices": ["com.m5stack", "com.m5stack.core2", "com.m5stack.cores3"]
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "lib": ["es2025", "esnext.disposable"]
      }
    }
  }
}
