{
  "defines": {
    "XS_MODS": 1
  },
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/examples/manifest_net.json",
    "$(MODULES)/base/modules/manifest.json",
    "$(MODULES)/data/crc/manifest.json",
    "../modules/motion/manifest.json",
    "../modules/audio/manifest.json",
    "../modules/connectivity/manifest.json",
    "../modules/conversation/manifest.json",
    "../modules/camera/manifest.json",
    "../modules/lighting/manifest.json",
    "../modules/ui/manifest.json",
    "../modules/input/manifest.json",
    "../modules/util/manifest.json",
    "../modules/preferences/manifest.json",
    "./manifest_typings.json"
  ],
  "modules": {
    "*": [
      "./main",
      "./compose",
      "./capabilities",
      "./runtime-context",
      "$(MODULES)/network/http/*"
    ],
    "startup-splash": "../modules/ui/views/splash/splash-view",
    "camera-preview": "../modules/ui/views/camera-preview/camera-preview-view",
    "camera-preview-utils": "../modules/ui/views/camera-preview/camera-preview-utils",
    "default-mods/*": "./default-behavior/*"
  },
  "preload": [
    "runtime-context",
    "touch",
    "touch-panel",
    "touch-panel-gesture",
    "imu",
    "imu-motion",
    "tone"
  ],
  "strip": [],
  "config": {
    "sntp": "pool.ntp.org",
    "driver": {
      "panId": 1,
      "tiltId": 2,
      "pwmPan": 5,
      "pwmTilt": 2,
      "offsetTilt": 0,
      "offsetPan": 0
    },
    "serial": {
      "transmit": 17,
      "receive": 16
    },
    "enablePowerButton": true
  },
  "resources": {
    "*-mask": ["$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-24"],
    "*-alpha": [
      {
        "source": "../modules/ui/assets/fonts/k8x12",
        "size": 12,
        "characterFiles": "../modules/ui/assets/fonts/k8x12-chars.txt",
        "monochrome": true
      }
    ]
  },
  "bundle": {
    "id": "tech.moddable.stackchan",
    "devices": [
      "com.m5stack",
      "com.m5stack.fire",
      "com.m5stack.core2",
      "com.m5stack.cores3"
    ]
  },
  "platforms": {
    "esp32/m5stack_core2": {
      "creation": {
        "static": 442368,
        "chunk": {
          "initial": 8192,
          "incremental": 2048
        },
        "heap": {
          "initial": 512,
          "incremental": 64
        },
        "stack": 512,
        "keys": {
          "available": 512
        }
      },
      "config": {
        "driver": {
          "pwmPan": 19,
          "pwmTilt": 27
        },
        "tts": {
          "sampleRate": 24000
        },
        "serial": {
          "transmit": 14,
          "receive": 13
        }
      }
    },
    "esp32/m5stack_cores3": {
      "creation": {
        "static": 0,
        "chunk": {
          "initial": 262144,
          "incremental": 0
        },
        "heap": {
          "initial": 4096,
          "incremental": 256
        },
        "stack": 512,
        "keys": {
          "initial": 32,
          "incremental": 32
        }
      },
      "config": {
        "touchIntervalMs": 50,
        "driver": {
          "type": "dynamixel",
          "panId": 1,
          "tiltId": 2
        },
        "tts": {
          "sampleRate": 24000
        },
        "serial": {
          "transmit": 7,
          "receive": 6
        },
        "virtualButton": false
      }
    },
    "esp32/m5stackchan_cores3": {
      "creation": {
        "static": 0,
        "chunk": {
          "initial": 262144,
          "incremental": 0
        },
        "heap": {
          "initial": 4096,
          "incremental": 256
        },
        "stack": 512,
        "keys": {
          "initial": 32,
          "incremental": 32
        }
      }
    },
    "esp32/m5atom_s3": {
      "config": {
        "ui": {
          "type": "small-face"
        },
        "driver": {
          "type": "none"
        }
      }
    },
    "esp32/m5atom_s3r": {
