          "type": "none"
        }
      }
    },
    "lin/m5atom_s3": {
      "creation": {
        "stack": 1024
      },
      "config": {
        "ui": {
          "type": "small-face"
        },
        "driver": {
          "type": "none"
        }
      }
    },
    "win/m5atom_s3": {
