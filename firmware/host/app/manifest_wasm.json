{
  "defines": {
    "XS_MODS": 1
  },
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODULES)/base/modules/manifest.json",
    "$(MODULES)/data/crc/manifest.json",
    "../modules/ui/manifest_wasm.json",
    "../modules/input/manifest.json",
    "../modules/util/manifest.json",
    "../modules/preferences/manifest.json",
    "./manifest_typings.json"
  ],
  "modules": {
    "*": ["./main", "./compose", "./capabilities", "./runtime-context"],
    "startup-splash": "../modules/ui/views/splash/splash-view",
    "camera": "../../stackchan/wasm/camera",
    "wasm-camera-bridge": "../../stackchan/wasm/camera-bridge",
    "camera-preview": "../../stackchan/wasm/camera-preview",
    "camera-preview-utils": "../modules/ui/views/camera-preview/camera-preview-utils",
    "runtime-bitmap-port": "../../stackchan/runtime-bitmap-port",
    "wasm-audio-bridge": "../../stackchan/wasm/audio-bridge",
    "tone": "../../stackchan/wasm/tone",
    "led": "../../stackchan/wasm/led",
    "wasm-driver": "../../stackchan/drivers/wasm/wasm-driver",
    "dynamixel-driver": "../../stackchan/drivers/wasm/dynamixel-driver",
    "m5stackchan-servo-driver": "../../stackchan/drivers/wasm/m5stackchan-servo-driver",
    "none-driver": "../../stackchan/drivers/wasm/none-driver",
    "sg90-driver": "../../stackchan/drivers/wasm/sg90-driver",
    "rs30x-driver": "../../stackchan/drivers/wasm/rs30x-driver",
    "scservo-driver": "../../stackchan/drivers/wasm/scservo-driver",
    "py32-led": "../../stackchan/wasm/py32-led",
    "microphone": "../../stackchan/wasm/microphone",
    "embedded:io/audio/in": "../../stackchan/wasm/audio-in",
    "network-service": "../../stackchan/services/wasm/network-service",
    "preference-server": "../../stackchan/services/wasm/preference-server",
    "tts-local": "../../stackchan/speeches/wasm/tts-local",
    "tts-remote": "../../stackchan/speeches/wasm/tts-remote",
    "tts-voicevox": "../../stackchan/speeches/wasm/tts-voicevox",
    "tts-voicevox-web": "../../stackchan/speeches/wasm/tts-voicevox-web",
    "tts-elevenlabs": "../../stackchan/speeches/wasm/tts-elevenlabs",
    "tts-openai": "../../stackchan/speeches/wasm/tts-openai",
    "default-mods/wasm/mod": "./default-behavior/wasm/mod",
    "default-mods/wasm/on-launch": "./default-behavior/wasm/on-launch",
    "default-mods/mod": "./default-behavior/wasm/mod",
    "default-mods/wasm/*": "./default-behavior/wasm/*",
    "default-mods/*": "./default-behavior/*"
  },
  "preload": [
    "wasm-audio-bridge",
    "wasm-camera-bridge",
    "runtime-context",
    "touch-panel",
    "touch-panel-gesture",
    "imu-motion",
    "default-mods/wasm/mod"
  ],
  "strip": [],
  "creation": {
    "static": 442368,
    "chunk": {
      "initial": 8192,
      "incremental": 2048
    },
    "heap": {
      "initial": 512,
      "incremental": 64
    },
    "stack": 512,
    "keys": {
      "available": 512
    }
  },
  "config": {
    "wasm": true,
    "driver": {
      "type": "none"
    },
    "tts": {
      "type": "local"
    },
    "ui": {
      "type": "simple"
    }
  },
  "resources": {
    "*-mask": ["$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-24"],
    "*-alpha": [
      {
        "source": "../../stackchan/assets/fonts/k8x12",
        "size": 12,
        "characterFiles": "../../stackchan/assets/fonts/k8x12-chars.txt",
        "monochrome": true
      }
    ]
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "strictFunctionTypes": false
      }
    }
  }
}
