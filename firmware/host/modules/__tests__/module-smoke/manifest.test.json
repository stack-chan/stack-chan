{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "../../util/manifest.json",
    "../../audio/manifest.json",
    "../../conversation/manifest.json",
    "../../connectivity/__tests__/network-service/manifest.json",
