{
  "include": ["$(MODDABLE)/examples/manifest_base.json", "../../manifest.json"],
  "modules": {
    "*": ["./main"],
    "audio-duplex-device-test": "../audio-duplex-device/amp-readback"
  },
  "config": {
    "startupSound": false,
    "aecWaveform": {
      "profile": "quiet",
      "hardwareAttenuationDb": 60,
      "safeHardwareAttenuationDb": 96,
      "probePeak": 12000,
      "captureSamples": 16384,
      "startDelayMs": 3000,
      "warmupMs": 3500,
      "captureMs": 1200
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "lib": ["es2025", "esnext.disposable"]
      }
    }
  }
}
