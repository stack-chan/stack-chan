{
  "include": [
    "$(MODDABLE)/modules/base/modules/manifest.json",
    "../../platforms/m5stackchan-cores3/manifest.json",
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/modules/data/url/manifest.json",
    "../../../../app/manifest_typings.json",
    "$(MODDABLE)/modules/data/xml/manifest.json",
    "../../../testing/manifest.json"
  ],
  "modules": {
    "stackchan/voice/contracts": "../../../voice/contracts",
    "stackchan/voice/scope": "../../../voice/scope",
    "stackchan/voice/media": "../../../voice/media",
    "stackchan/voice/runtime": "../../../voice/runtime",
    "stackchan/voice/pcm-energy": "../../../voice/pcm-energy",
    "stackchan/voice/device": "../../../voice/pcm-device",
    "~": "$(MODDABLE)/modules/base/timer/timer.js",
    "stackchan/voice/cores3-pcm-output": "../../../voice/cores3-pcm-output",
    "pins/audioout": "../../../testing/fakes/audio-out",
    "main": "./media-playback.test",
    "timer": "./timer",
    "capabilities": "../../../testing/fakes/capabilities",
    "speech-playback-types": "../../speech-playback-types",
    "embedded:io/audio/out": "./driver",
    "test-http": "./http",
    "worker": "./worker",
    "esp32-mp3-decoder": "./decoder",
    "podcast-controller": "../../../../../mods/examples/podcast/controller",
    "podcast-feed": "../../../../../mods/examples/podcast/feed-core",
    "podcast-rss-parser": "../../../../../mods/examples/podcast/rss-parser",
    "podcast-rss-tests": "../../../../../mods/examples/podcast/__tests__/rss-native.test",
    "podcast-feed-proxy": "../../../../../mods/examples/podcast/feed"
  },
  "defines": {
    "main": {
      "async": 1
    }
  },
  "creation": {
    "static": 2097152,
    "chunk": {
      "initial": 524288,
      "incremental": 65536
    },
    "heap": {
      "initial": 16384,
      "incremental": 1024
    },
    "stack": 1024
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false
      }
    }
  }
}
