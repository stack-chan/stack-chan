{
  "include": [
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/examples/pins/audioout/resource-stream/manifest_streamer.json",
    "$(MODDABLE)/examples/pins/audioout/http-stream/manifest_wavstreamer.json",
    "$(MODDABLE)/examples/pins/audioout/elevenlabs-stream/manifest_elevenlabsstreamer.json",
    "$(MODDABLE)/examples/pins/audioout/openai-stream/manifest_openaistreamer.json",
    "$(MODDABLE)/examples/pins/audioout/mp3-http-stream/manifest_mp3streamer.json",
    "$(MODDABLE)/examples/io/tcp/fetch/manifest_fetch.json",
    "$(MODDABLE)/modules/base/worker/manifest.json",
    "$(MODDABLE)/modules/base/uuid/manifest.json",
    "$(MODDABLE)/modules/data/headers/manifest.json",
    "$(MODDABLE)/modules/data/url/manifest.json",
    "../util/manifest.json",
    "./manifest_file.json",
    "../../app/manifest_typings.json"
  ],
  "modules": {
    "*": [
      "./*",
      "$(MODDABLE)/examples/pins/audioout/http-stream/calculatePower",
      "../../../typings/elevenlabsstreamer",
      "../../../typings/resourcestreamer",
      "../../../typings/wavstreamer",
      "../../../typings/mp3streamer"
    ],
    "audio-in": "./audio-in"
  },
  "preload": [
    "audio-in",
    "audio-buffer",
    "microphone",
    "speaker",
    "stt-whisper",
    "calculatePower",
    "tts-local",
    "tts-remote",
    "tts-voicevox",
    "tts-voicevox-web",
    "tts-elevenlabs",
    "tts-openai",
    "tts-stackchan-voice"
  ],
  "data": {
    "*": [
      "$(MODULES)/crypt/data/ca109",
      "$(MODULES)/crypt/data/ca176",
      "$(MODULES)/crypt/data/ca236"
    ]
  },
  "config": {
    "tls": {
      "DHE_RSA": false
    }
  },
  "defines": {
    "audioIn": {
      "sampleRate": 16000,
      "bitsPerSample": 16
    }
  },
  "platforms": {
    "mac": {
      "modules": {
        "*": "$(MODDABLE)/modules/io/common/builtinCommon",
        "embedded:io/audio/in": "$(MODDABLE)/modules/io/audioin/mac/audioin"
      },
      "defines": {
        "audioOut": {
          "bitsPerSample": 16,
          "numChannels": 1,
          "sampleRate": 11025
        }
      }
    },
    "lin": {
      "include": ["$(MODDABLE)/modules/io/audioout/manifest.json"],
      "modules": {
        "*": "$(MODDABLE)/modules/io/common/builtinCommon",
        "embedded:io/audio/in": "$(MODDABLE)/modules/io/audioin/lin/audioin"
      }
    },
    "win": {
      "modules": {
        "*": "$(MODDABLE)/modules/io/common/builtinCommon",
        "embedded:io/audio/in": "$(MODDABLE)/modules/io/audioin/win/audioin"
      }
    },
    "esp32": {
      "modules": {
        "*": "$(MODDABLE)/modules/io/common/builtinCommon",
        "embedded:io/audio/in": "$(MODDABLE)/modules/io/audioin/esp32/audioin"
      },
      "dependency": [
        {
          "idf": "esp_driver_i2s"
        }
      ],
      "defines": {
        "audioOut": {
          "bitsPerSample": 16,
          "numChannels": 1,
          "sampleRate": 11025
        }
      }
    },
    "esp32/m5stack_fire": {
      "modules": {
        "audio-in": "./platforms/m5stack-fire/audio-in"
      }
    },
    "esp32/m5stack_cores3": {
      "defines": {
        "audioOut": {
          "bitsPerSample": 16,
          "numChannels": 1,
          "sampleRate": 24000
        }
      }
    },
    "esp32/m5stackchan_cores3": {
      "include": [
        "$(MODDABLE)/modules/io/audioout/manifest.json",
        "../../../vendor/stackchan-voice/manifest.json"
      ],
      "build": {
        "SDKCONFIGPATH ?=": "./platforms/m5stackchan-cores3/sdkconfig"
      },
      "modules": {
        "~": "./tts-stackchan-voice",
        "*": "$(MODDABLE)/modules/io/common/builtinCommon",
        "esp32-mp3-decoder": "./platforms/m5stackchan-cores3/esp32-mp3-decoder",
        "web-radio-player": "./platforms/m5stackchan-cores3/web-radio-player",
        "web-radio-audio-out": "./platforms/m5stackchan-cores3/web-radio-audio-out",
        "pcm-resampler": "./platforms/m5stackchan-cores3/pcm-resampler",
        "buffered-mp3streamer": "./platforms/m5stackchan-cores3/worker-mp3streamer",
        "buffered-mp3streamer-core": "./platforms/m5stackchan-cores3/buffered-mp3streamer",
        "web-radio-byte-ring": "./platforms/m5stackchan-cores3/shared-byte-ring",
        "web-radio-stream-worker": "./platforms/m5stackchan-cores3/web-radio-stream-worker",
        "stackchanCores3AudioOutNative": "./platforms/m5stackchan-cores3/io-audioout/audioout-esp32",
        "stackchanCores3AudioInNative": "./platforms/m5stackchan-cores3/io-audioin/audioin",
        "cores3I2SBus": "./platforms/m5stackchan-cores3/cores3-i2s-bus",
        "embedded:io/audio/out-original": "./platforms/m5stackchan-cores3/io-audioout/audioout-esp32",
        "embedded:io/audio/out": "./platforms/m5stackchan-cores3/cores3-audio-out",
        "embedded:io/audio/in": "./platforms/m5stackchan-cores3/cores3-audio-in",
        "tts-stackchan-voice": "./stackchan-voice/tts-stackchan-voice"
      },
      "dependency": [
        {
          "idf": "esp_driver_i2s"
        },
        {
          "name": "esp_audio_codec",
          "version": "^2.6.0",
          "includes": ["include/decoder", "include/decoder/impl"]
        }
      ],
      "defines": {
        "audioOut": {
          "bitsPerSample": 16,
          "numChannels": 1,
          "sampleRate": 24000,
          "i2s": {
            "num": 1,
            "slot": "I2S_STD_SLOT_LEFT",
            "format_i2s": 1,
            "bitsPerSample": 16,
            "bck_pin": 34,
            "lr_pin": 33,
            "mck_pin": -1,
            "dataout_pin": 13
          }
        }
      }
    },
    "esp32/stackchan_rt": {
      "modules": {
        "*": "$(MODDABLE)/modules/io/common/builtinCommon",
        "embedded:io/audio/in": "$(MODDABLE)/modules/io/audioin/esp32/audioin"
      },
      "dependency": [
        {
          "idf": "esp_driver_i2s"
        }
      ],
      "defines": {
        "audioOut": {
          "bitsPerSample": 16,
          "numChannels": 1,
          "sampleRate": 24000
        }
      }
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false
      }
    }
  }
}
