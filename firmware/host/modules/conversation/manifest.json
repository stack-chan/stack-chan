{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/examples/io/tcp/fetch/manifest_fetch.json",
    "$(MODULES)/base/structuredClone/manifest.json",
    "$(MODDABLE)/modules/data/headers/manifest.json",
    "../util/manifest.json",
    "../connectivity/mcp-client/manifest.json"
  ],
  "modules": {
    "*": ["./*"],
    "ChatAudioIO": "./chat-audioio-stub"
  },
  "preload": ["dialogue-chatgpt", "dialogue-claude", "dialogue-gemini"],
  "data": {
    "*": ["$(MODULES)/crypt/data/ca236", "$(MODULES)/crypt/data/ca233"]
  },
  "platforms": {
    "esp32/m5stack_cores3": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "ChatAudioIO": "./chat-audioio/worker-stack",
        "ChatAudioIOBase": "$(MODULES)/network/services/chatAudioIO/ChatAudioIO"
      }
    },
    "esp32/m5stackchan_cores3": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "ChatAudioIO": "./chat-audioio/worker-stack",
        "ChatAudioIOBase": "$(MODULES)/network/services/chatAudioIO/ChatAudioIO"
      }
    },
    "mac": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "ChatAudioIO": "$(MODULES)/network/services/chatAudioIO/ChatAudioIO"
      }
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false
      }
    }
  }
}
