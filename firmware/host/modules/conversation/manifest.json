{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODULES)/base/modules/manifest.json",
    "../connectivity/mcp-client/manifest.json"
  ],
  "modules": {
    "*": ["./*"],
    "StackChanChatAudioIO": "./StackChanChatAudioIO",
    "stackchan/voice/contracts": "../voice/contracts",
    "stackchan/voice/scope": "../voice/scope",
    "stackchan/voice/media": "../voice/media",
    "stackchanBorrowedChatIO": "./chat-audioio/borrowed-io",
    "stackchanChatWorkerSession": "./chat-audioio/worker-session",
    "stackchanVoiceChatWorker": "./chat-audioio/ack-worker",
    "stackchanPcmRingWriter": "./chat-audioio/pcm-ring-writer"
  },
  "platforms": {
    "esp32/m5stack_cores3": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "~": "./StackChanChatAudioIO",
        "StackChanChatAudioIO": "./chat-audioio/worker-stack"
      }
    },
    "esp32/m5stackchan_cores3": {
      "config": {
        "xiaozhiV1Available": true
      },
      "include": [
        "$(MODULES)/network/services/chatAudioIO/manifest.json",
        "./chat-audioio/server.manifest.json"
      ],
      "modules": {
        "~": ["./StackChanChatAudioIO", "./chat-audioio/pcm-ring-writer"],
        "StackChanChatAudioIO": "./chat-audioio/worker-stack",
        "stackchanPcmRingWriter": "./chat-audioio/pcm-ring-writer-native"
      },
      "defines": {
        "audioIn": {
          "sampleRate": 16000,
          "bitsPerSample": 16,
          "numChannels": 2,
          "i2s": {
            "num": 1,
            "slot": "I2S_STD_SLOT_BOTH",
            "format_i2s": 1,
            "bck_pin": 34,
            "lr_pin": 33,
            "mck_pin": 0,
            "datain": 14
          }
        }
      }
    },
    "esp32/stackchan_rt": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "~": "./StackChanChatAudioIO",
        "StackChanChatAudioIO": "./chat-audioio/worker-stack"
      }
    },
    "mac": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "~": "./StackChanChatAudioIO",
        "StackChanChatAudioIO": "./chat-audioio/worker-stack"
      }
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false
      }
    }
  }
}
