{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "../connectivity/mcp-client/manifest.json"
  ],
  "modules": {
    "*": ["./*"],
    "ChatAudioIO": "./chat-audioio-stub",
    "stackchanChatAudioIO": "./chat-audioio/worker-stack"
  },
  "platforms": {
    "esp32/m5stack_cores3": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"]
    },
    "esp32/m5stackchan_cores3": {
      "include": [
        "$(MODULES)/network/services/chatAudioIO/manifest.json",
        "./chat-audioio/server.manifest.json"
      ],
      "modules": {
        "stackchanOpusDecoder": "../audio/platforms/m5stackchan-cores3/esp32-opus-decoder",
        "stackchanOpusEncoder": "../audio/platforms/m5stackchan-cores3/esp32-opus-encoder"
      }
    },
    "esp32/stackchan_rt": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"]
    },
    "mac": {
      "include": ["$(MODULES)/network/services/chatAudioIO/manifest.json"],
      "modules": {
        "ChatAudioIO": "$(MODULES)/network/services/chatAudioIO/ChatAudioIO"
      }
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "useUnknownInCatchVariables": false
      }
    }
  }
}
