{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/modules/embedded/io/serial/manifest.json",
    "../util/manifest.json",
    "../io-expander/manifest.json"
  ],
  "modules": {
    "*": ["./*", "./internal/*"],
    "protocols/*": "./protocols/*"
  },
  "preload": [
    "motion-controller",
    "motion-driver-callback",
    "none-driver",
    "sg90-driver",
    "payload-buffer",
    "internal/single-wait-slot",
    "internal/servo-command-error"
  ],
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "strictFunctionTypes": false
      }
    }
  },
  "platforms": {
    "esp32": {
      "include": ["$(MODDABLE)/modules/embedded/io/pwm/manifest.json"]
    }
  }
}
