{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/modules/io/manifest.json",
    "../util/manifest.json",
    "../io-expander/manifest.json",
    "../../../sdk/manifest.json"
  ],
  "modules": {
    "*": ["./*", "./internal/*"],
    "protocols/*": "./protocols/*"
  },
  "preload": [
    "motion-driver",
    "motion-driver-callback",
    "protocols/dynamixel",
    "dynamixel-driver",
    "m5stackchan-servo",
    "m5stackchan-servo-driver",
    "none-driver",
    "protocols/rs30x",
    "protocols/scservo",
    "sg90-driver",
    "rs30x-driver",
    "scservo-driver",
    "protocols/dynamixel-codec",
    "payload-buffer",
    "servo-bus",
    "servo-bus-runtime",
    "servo-driver-resources",
    "internal/servo-command-error"
  ],
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "strictFunctionTypes": false
      }
    }
  }
}
