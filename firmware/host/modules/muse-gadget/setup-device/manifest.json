  "modules": {
    "main": "./main",
    "muse-native-speech-enabled": "./native-speech-disabled",
    "muse-caption-layout": "./caption-layout",
    "muse-talk-controls": "./talk-controls",
    "muse-diagnostic-heap": "./diagnostic-heap",
    "muse-speech-diagnostics": "./speech-diagnostics",
    "muse-talk-feedback": "./talk-feedback",
    "muse-setup-metadata": "./metadata",
