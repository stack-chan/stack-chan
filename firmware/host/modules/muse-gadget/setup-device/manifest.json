    "muse-stopwatch-output": "../stopwatch-audio/output",
    "muse-resampled-output": "./resampled-output",
    "pcm-resampler": "../../audio/platforms/m5stackchan-cores3/pcm-resampler",
    "stackchan/voice/cores3-pcm-output": "./cascaded-output",
    "stackchan/voice/device": "../../voice/pcm-device",
    "stackchan/voice/pipeline": "../../voice/pipeline",
    "stackchan/voice/runtime": "../../voice/runtime",
    "stackchan/voice/levels": "../../voice/levels",
    "guruguru-view": "./kasane-view",
    "guruguru-avatar": "../../../../mods/examples/guruguru_voice/avatar",
    "kasane-frames": "./kasane-frames",
    "audio-in": "../stopwatch-audio/input",
    "muse-response-expression": "./response-expression",
    "muse-stopwatch-levels": [
      "../stopwatch-audio/levels.js",
      "$(MODULES)/network/services/chatAudioIO/ChatAudioIO.c"
