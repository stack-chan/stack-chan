{
  "modules": {
    "realtimeConversation/transport": "./transport.js",
    "*": [
      "./transport.c",
      "./media-init.c",
      "./liveAudio.c",
      "../../../platforms/m5stackchan_cores3/io-performance.c",
      "../../../platforms/m5stackchan_cores3/media-scheduler.c",
      "../../../platforms/m5stackchan_cores3/opus-policy.c"
    ],
    "io-performance": "../../../platforms/m5stackchan_cores3/io-performance"
  },
  "build": {
    "C_FLAGS": "$(C_COMMON_FLAGS) -Wno-implicit-function-declaration -std=gnu17 $(C_FLAGS_SUBPLATFORM) -I$(ESP_WEBRTC_SOLUTION)/components/esp_webrtc/include -I$(ESP_WEBRTC_SOLUTION)/components/esp_webrtc/impl/whip_signal/include -I$(ESP_WEBRTC_SOLUTION)/components/esp_webrtc/impl/janus_signal/include -I$(ESP_WEBRTC_SOLUTION)/components/esp_peer/include -I$(ESP_WEBRTC_SOLUTION)/components/media_lib_utils/include -I$(ESP_WEBRTC_SOLUTION)/components/webrtc_utils -I$(ESP_WEBRTC_SOLUTION)/components/av_render/include -I$(MODDABLE)/modules/piu/MC -I$(STACKCHAN_REALTIME_PLATFORM)",
    "STACKCHAN_REALTIME_PLATFORM": "./../../../platforms/m5stackchan_cores3"
  },
  "esp32Config": {
    "CONFIG_MBEDTLS_SSL_PROTO_DTLS": "y",
    "CONFIG_MBEDTLS_SSL_DTLS_SRTP": "y",
    "CONFIG_MBEDTLS_X509_CREATE_C": "y",
    "CONFIG_AUDIO_ENCODER_OPUS_SUPPORT": "y",
    "CONFIG_AUDIO_DECODER_OPUS_SUPPORT": "y",
    "CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM": "y",
    "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL": "1024",
    "CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL": "98304",
    "CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC": "n",
    "CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC": "y"
  },
  "dependencies": [
    {
      "idf": "esp_webrtc"
    },
    {
      "idf": "esp_peer"
    },
    {
      "idf": "webrtc_utils"
    },
    {
      "idf": "av_render"
    },
    {
      "name": "esp_capture",
      "version": "==1.0.4",
      "includes": ["include", "interface"]
    },
    {
      "name": "esp_audio_codec",
      "version": "~2.5",
      "includes": [
        "include",
        "include/encoder",
        "include/decoder",
        "include/encoder/impl",
        "include/decoder/impl"
      ]
    },
    {
      "name": "esp_audio_effects",
      "version": "~1.3",
      "includes": ["include"]
    },
    {
      "name": "media_lib_sal",
      "version": "~0.9",
      "includes": ["include", "include/port"]
    },
    {
      "name": "cjson",
      "version": "^1.7.19",
      "includes": ["cJSON"]
    },
    {
      "name": "esp_muxer",
      "version": "~1.2",
      "includes": ["include"]
    }
  ]
}
