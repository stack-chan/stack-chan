{
  "include": [
    "./portable/manifest.json",
    "$(MODDABLE)/modules/data/base64/manifest.json",
    "$(MODDABLE)/modules/data/text/decoder/manifest.json"
  ],
  "modules": {
    "realtimeConversation": "./realtimeConversation",
    "realtimeConversation/core": "./core",
    "realtimeConversation/tools": "./tools",
    "realtimeConversation/http": "./http",
    "realtimeConversation/http-proxy": "./http-proxy",
    "realtimeConversation/http-options": "./http-options",
    "realtimeConversation/http-core": "./http-core",
    "realtimeConversation/http-worker": "./http-worker",
    "realtimeConversation/http-queue": "./http-queue"
  },
  "platforms": {
    "...": {
      "error": "RealtimeConversation host backend requires CoreS3 or M5StackChan CoreS3"
    },
    "esp32/m5stack_cores3": {
      "include": ["./esp32/manifest.json"]
    },
    "esp32/m5stackchan_cores3": {
      "include": ["./esp32/manifest.json"]
    }
  },
  "resources": {
    "ca*": ["$(MODDABLE)/modules/crypt/data/ca*"]
  },
  "defines": {
    "stackchan": {
      "realtime": 1
    }
  }
}
