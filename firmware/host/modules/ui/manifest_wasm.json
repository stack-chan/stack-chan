{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODDABLE)/examples/manifest_piu.json",
    "$(MODDABLE)/modules/piu/MC/outline/manifest.json",
    "$(MODULES)/commodetto/outline/manifest.json",
    "../util/manifest.json"
  ],
  "modules": {
    "app-controller": "./application/app-controller",
    "chat-status-bar": "./components/status-bar/chat-status-bar",
    "common-view": "./views/main/common-view",
    "face-view": "./views/main/face-view",
    "settings-view": "./views/settings/settings-view",
    "settings-status-model": "./views/settings/settings-status-model",
    "face-state": "./state/face-state",
    "face-skin": "./state/face-skin",
    "template": "./components/face/template",
    "motions/*": "./components/face/motions/*",
    "drawer": "./components/drawer/drawer",
    "effects/speech-balloon": "./components/bubble/speech-balloon",
    "effects/multirow-balloon": "./components/bubble/multirow-balloon",
    "effects/*": "./components/effects/*",
    "parts/image/*": "./components/face/parts/image/*",
    "parts/dog/*": "./components/face/parts/dog/*",
    "parts/*": "./components/face/parts/*",
    "behaviors/*": "./components/face/behaviors/*",
    "startup-splash": "./views/splash/splash-view",
    "camera-preview-utils": "./views/camera-preview/camera-preview-utils",
    "piuDie": "$(PIU)/MC/piuDie",
    "piuFont": "$(PIU)/MC/piuFont",
    "piuRegion": "$(PIU)/MC/piuRegion",
    "piuTexture": "$(PIU)/MC/piuTexture",
    "piuView": "$(PIU)/MC/piuView"
  },
  "resources": {
    "*-alpha": [
      "./assets/images/microphone",
      "./assets/images/indicator",
      "./assets/images/bubble",
      "./assets/images/emoticon",
      "./assets/images/faces/image-face/moddable-avatar/eye",
      "./assets/images/faces/image-face/moddable-avatar/eyelid",
      "./assets/images/faces/image-face/moddable-avatar/mouth",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-head-normal",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-left-normal",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-right-normal",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-mouth-normal",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-left-normal",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-right-normal",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-head-happy",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-left-happy",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-right-happy",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-mouth-happy",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-left-happy",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-right-happy",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-head-sad",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-left-sad",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-right-sad",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-mouth-sad",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-left-sad",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-right-sad",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-head-angry",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-left-angry",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-eye-right-angry",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-mouth-angry",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-left-angry",
      "./assets/images/faces/image-avatar/stackchan-demo/stackchan-demo-hand-right-angry"
    ],
    "*-color": [],
    "*-mask": [
      "$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-20",
      "$(MODDABLE)/examples/assets/fonts/OpenSans-Regular-16"
    ]
  },
  "preload": [
    "piu/Application",
    "piu/Behavior",
    "piu/Color",
    "piu/Column",
    "piu/Container",
    "piu/Content",
    "piu/Label",
    "piu/Layout",
    "piu/Locals",
    "piu/Port",
    "piu/Rectangle",
    "piu/Row",
    "piu/Scroller",
    "piu/Skin",
    "piu/Style",
    "piu/Text",
    "piu/Timeline",
    "piu/Transition",
    "face-skin",
    "piuDie",
    "piuFont",
    "piuRegion",
    "piuTexture",
    "piuView"
  ],
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false
      }
    }
  }
}
