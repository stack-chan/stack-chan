{
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "../../app/manifest_typings.json"
  ],
  "modules": {
    "stackchan-util": "./stackchan-util",
    "mac-address": "./sim/mac-address"
  },
  "preload": ["stackchan-util", "mac-address"],
  "platforms": {
    "esp32": {
      "modules": {
        "mac-address": "./esp32/mac-address"
      }
    },
    "mac": {
      "modules": {
        "mac-address": "./sim/mac-address",
        "embedded:io/pwm": "./sim/pwm"
      }
    },
    "lin": {
      "modules": {
        "mac-address": "./sim/mac-address",
        "embedded:io/pwm": "./sim/pwm"
      }
    },
    "win": {
      "modules": {
        "mac-address": "./sim/mac-address",
        "embedded:io/pwm": "./sim/pwm"
      }
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "noImplicitThis": false
      }
    }
  }
}
