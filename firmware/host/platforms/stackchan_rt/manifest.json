{
  "build": {
    "SUBPLATFORM": "stackchan_rt"
  },
  "include": ["$(BUILD)/devices/esp32/targets/m5stack_cores3/manifest.json"],
  "config": {
    "driver": {
      "type": "dynamixel",
      "panId": 1,
      "tiltId": 2,
      "serial": {
        "transmit": 7,
        "receive": 6,
        "port": 1,
        "baud": 1000000
      }
    },
    "serial": {
      "transmit": 7,
      "receive": 6,
      "port": 1,
      "baud": 1000000
    },
    "touchIntervalMs": 50,
    "virtualButton": false
  },
  "defines": {
    "ft6206": {
      "hz": 400000
    }
  }
}
