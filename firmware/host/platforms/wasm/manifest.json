{
  "defines": {
    "XS_MODS": 1
  },
  "include": [
    "$(MODDABLE)/examples/manifest_base.json",
    "$(MODDABLE)/examples/manifest_typings.json",
    "$(MODULES)/base/modules/manifest.json",
    "$(MODULES)/data/crc/manifest.json",
    "../../modules/ui/manifest_wasm.json",
    "../../modules/audio/manifest_wasm.json",
    "../../modules/motion/manifest_wasm.json",
    "../../modules/camera/manifest_wasm.json",
    "../../modules/connectivity/manifest_wasm.json",
    "../../modules/input/manifest_wasm.json",
    "../../modules/util/manifest.json",
    "../../modules/preferences/manifest_wasm.json",
    "../../app/manifest_typings.json",
    "../../app/manifest_runtime.json",
    "../../app/manifest_entry.json"
  ],
  "modules": {
    "*": [],
    "startup-splash": "../../modules/ui/views/splash/splash-view",
    "camera-preview-utils": "../../modules/ui/views/camera-preview/camera-preview-utils",
    "led": "../../modules/lighting/wasm/led",
    "py32-led": "../../modules/lighting/wasm/py32-led"
  },
  "preload": [
    "wasm-audio-bridge",
    "wasm-camera-bridge",
    "runtime-context",
    "touch-panel",
    "touch-panel-gesture",
    "imu-motion"
  ],
  "strip": [],
  "creation": {
    "static": 442368,
    "chunk": {
      "initial": 8192,
      "incremental": 2048
    },
    "heap": {
      "initial": 512,
      "incremental": 64
    },
    "stack": 512,
    "keys": {
      "available": 512
    }
  },
  "config": {
    "wasm": true,
    "driver": {
      "type": "none"
    },
    "tts": {
      "type": "stackchan-voice",
      "voice": "normal",
      "speed": 100,
      "volume": 0.5
    },
    "ui": {
      "type": "simple"
    }
  },
  "typescript": {
    "tsconfig": {
      "compilerOptions": {
        "noImplicitAny": false,
        "strictNullChecks": false,
        "strictPropertyInitialization": false,
        "strictFunctionTypes": false
      }
    }
  }
}
