{
  "include": [
    "$(MODDABLE)/examples/manifest_mod.json",
    "$(MODDABLE)/examples/manifest_typings.json"
  ],
  "typescript": {
    "tsconfig": {
      "compilerOptions": { "allowJs": true }
    }
  },
  "modules": {
    "*": ["./mod", "./jump", "./catch"]
  },
  "resources": {
    "*": ["./assets/stack-chan"],
    "*-mask": [
      "./assets/player-left",
      "./assets/player-center",
      "./assets/player-right",
      "./assets/screw",
      "./assets/m5stack",
      "./assets/bubble",
      "./assets/bomb",
      "./assets/miss"
    ]
  },
  "data": {
    "stackchan-mod": ["./stackchan-mod.json"]
  }
}
