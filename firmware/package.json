{
  "name": "stack-chan",
  "version": "1.0.0",
  "description": "A firmware of M5Stack Stack-chan module",
  "main": "host/app/main.ts",
  "scripts": {
    "format": "biome format host mods scripts",
    "format:fix": "npm run format -- --write",
    "lint": "biome lint host mods scripts",
    "lint:fix": "npm run lint -- --write",
    "clean": "node scripts/clean.mjs",
    "check:legacy-names": "node scripts/check-legacy-names.js",
    "check:architecture": "rm -rf dist-architecture && tsc --project tsconfig.architecture.json && node --test \"dist-architecture/host/**/*.architecture.js\"",
    "check:manifest": "node scripts/check-manifest.js",
    "check:release": "node scripts/validate-release.mjs",
    "extract-font-chars": "node scripts/extract-font-chars.js",
    "generate-speech-coqui": "node scripts/generate-speech-coqui.js",
    "generate-speech-voicevox": "node scripts/generate-speech-voicevox.js",
    "generate-speech-google": "cross-env GOOGLE_APPLICATION_CREDENTIALS=scripts/key.json node scripts/generate-speech-google.js",
    "generate-apidoc": "typedoc --entryPointStrategy expand --plugin typedoc-plugin-markdown --out docs/api ./host",
    "test": "npm run test:unit",
    "test:unit": "rm -rf dist-tests && tsc --project tsconfig.test.json && node --test \"dist-tests/host/**/*.test.js\" scripts/lib/build-output.test.mjs scripts/lib/firmware-bundle.test.mjs scripts/lib/firmware-command.test.mjs scripts/lib/idf-dependencies.test.mjs scripts/lib/mod-flash.test.mjs scripts/lib/moddable-version.test.mjs scripts/lib/release-validation.test.mjs",
    "test:moddable": "node scripts/run-module-tests.js",
    "test:web-radio-device:build": "node scripts/run-mcconfig.mjs -d -m -p esp32:./host/platforms/m5stackchan_cores3 -t build \"$PWD/host/modules/audio/__tests__/web-radio-device/manifest.json\"",
    "test:web-radio-device:flash": "node scripts/run-mcconfig.mjs -d -m -p esp32:./host/platforms/m5stackchan_cores3 \"$PWD/host/modules/audio/__tests__/web-radio-device/manifest.json\"",
    "test:http-throughput-server": "node host/modules/audio/__tests__/http-throughput-device/server.mjs",
    "test:http-throughput-device:build": "node scripts/run-mcconfig.mjs -d -m -p esp32:./host/platforms/m5stackchan_cores3 -t build \"$PWD/host/modules/audio/__tests__/http-throughput-device/manifest.json\"",
    "test:http-throughput-device:flash": "node scripts/run-mcconfig.mjs -d -m -p esp32:./host/platforms/m5stackchan_cores3 \"$PWD/host/modules/audio/__tests__/http-throughput-device/manifest.json\"",
    "benchmark:mini-app-layers:build": "node scripts/run-mcconfig.mjs -i -m -p esp32/m5stack_core2 -t build \"$PWD/benchmarks/mini-app-layers/manifest.json\"",
    "benchmark:mini-app-layers:flash": "node scripts/run-mcconfig.mjs -i -m -p esp32/m5stack_core2 \"$PWD/benchmarks/mini-app-layers/manifest.json\"",
    "test:device": "node scripts/run-device-smoke.js",
    "build": "node scripts/firmware.mjs build",
    "build:m5stackchan_cores3": "node scripts/firmware.mjs build m5stackchan_cores3",
    "build:stackchan_rt": "node scripts/firmware.mjs build stackchan_rt",
    "build:takao_core2_sg90": "node scripts/firmware.mjs build takao_core2_sg90",
    "build:m5stack": "node scripts/run-mcconfig.mjs -d -m -p esp32/m5stack -t build \"$PWD/host/app/manifest_local.json\"",
    "build:m5stack_cores3": "node scripts/run-mcconfig.mjs -d -m -p esp32/m5stack_cores3 -t build \"$PWD/host/app/manifest_local.json\"",
    "build:release:m5stack": "node scripts/bundle-target.mjs m5stack",
    "build:release:m5stack_core2": "node scripts/bundle-target.mjs m5stack_core2",
    "build:release:m5stack_cores3": "node scripts/bundle-target.mjs m5stack_cores3",
    "build:release:m5stackchan_cores3": "node scripts/bundle-target.mjs m5stackchan_cores3",
    "build:release:stackchan_rt": "node scripts/firmware.mjs build stackchan_rt --mode=release",
    "build:release:takao_core2_sg90": "node scripts/firmware.mjs build takao_core2_sg90 --mode=release",
    "build:lin": "node scripts/run-mcconfig.mjs -d -m -p lin -t build \"$PWD/host/app/manifest_local.json\"",
    "smoke:lin": "bash scripts/smoke-lin.sh",
    "smoke:mini-app:lin": "bash scripts/smoke-mini-app-lin.sh",
    "build:wasm": "bash scripts/build-wasm.sh",
    "build:editor-tools": "bash scripts/build-editor-tools.sh",
    "bundle": "node scripts/bundle.mjs",
    "bundle:package": "node scripts/package-bundle.mjs",
    "deploy": "node scripts/firmware.mjs deploy",
    "deploy:m5stackchan_cores3": "node scripts/firmware.mjs deploy m5stackchan_cores3",
    "deploy:stackchan_rt": "node scripts/firmware.mjs deploy stackchan_rt",
    "deploy:takao_core2_sg90": "node scripts/firmware.mjs deploy takao_core2_sg90",
    "flash": "node scripts/firmware.mjs flash",
    "flash:m5stackchan_cores3": "node scripts/firmware.mjs flash m5stackchan_cores3",
    "flash:stackchan_rt": "node scripts/firmware.mjs flash stackchan_rt",
    "flash:takao_core2_sg90": "node scripts/firmware.mjs flash takao_core2_sg90",
    "debug": "node scripts/firmware.mjs debug",
    "debug:m5stackchan_cores3": "node scripts/firmware.mjs debug m5stackchan_cores3",
    "debug:stackchan_rt": "node scripts/firmware.mjs debug stackchan_rt",
    "debug:takao_core2_sg90": "node scripts/firmware.mjs debug takao_core2_sg90",
    "debug:xsdb": "node scripts/firmware.mjs debug -dl",
    "debug:xsdb:m5stackchan_cores3": "node scripts/firmware.mjs debug m5stackchan_cores3 -dl",
    "debug:xsdb:stackchan_rt": "node scripts/firmware.mjs debug stackchan_rt -dl",
    "debug:xsdb:takao_core2_sg90": "node scripts/firmware.mjs debug takao_core2_sg90 -dl",
    "mod": "node scripts/firmware.mjs mod",
    "mod:build": "node scripts/firmware.mjs mod:build",
    "mod:m5stackchan_cores3": "node scripts/firmware.mjs mod m5stackchan_cores3",
    "mod:stackchan_rt": "node scripts/firmware.mjs mod stackchan_rt",
    "mod:takao_core2_sg90": "node scripts/firmware.mjs mod takao_core2_sg90",
    "setup": "xs-dev setup",
    "update": "xs-dev update",
    "doctor": "echo stack-chan environment info: && git rev-parse HEAD && git rev-parse --show-toplevel && xs-dev doctor",
    "scan": "xs-dev scan",
    "erase-flash": "esptool erase-flash",
    "install-hook": "lefthook install",
    "uninstall-hook": "lefthook uninstall"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/meganetaaan/stack-chan.git"
  },
  "keywords": [
    "M5Stack",
    "Robot",
    "Moddable",
    "Kawaii"
  ],
  "author": "Shinya Ishikawa",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/meganetaaan/stack-chan/issues"
  },
  "homepage": "https://github.com/meganetaaan/stack-chan#readme",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@microsoft/tsdoc": "^0.16.0",
    "@moddable/typings": "^8.3.1",
    "cross-env": "^10.1.0",
    "fontkit": "^2.0.2",
    "lefthook": "^2.1.10",
    "node-fetch": "^3.3.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "web-audio-engine": "^0.13.4",
    "xs-dev": "^1.12.1",
    "yargs": "^18.0.0"
  }
}
