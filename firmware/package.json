{
  "name": "stack-chan",
  "version": "0.2.1",
  "description": "A firmware of M5Stack Stack-chan module",
  "main": "host/app/main.ts",
  "scripts": {
    "format": "biome format host mods scripts",
    "format:fix": "npm run format -- --write",
    "lint": "biome lint host mods scripts",
    "lint:fix": "npm run lint -- --write",
    "check:legacy-names": "node scripts/check-legacy-names.js",
    "check:architecture": "rm -rf dist-architecture && tsc --project tsconfig.architecture.json && node --test \"dist-architecture/host/**/*.architecture.js\"",
    "extract-font-chars": "node scripts/extract-font-chars.js",
    "generate-speech-coqui": "node scripts/generate-speech-coqui.js",
    "generate-speech-voicevox": "node scripts/generate-speech-voicevox.js",
    "generate-speech-google": "cross-env GOOGLE_APPLICATION_CREDENTIALS=scripts/key.json node scripts/generate-speech-google.js",
    "generate-apidoc": "typedoc --entryPointStrategy expand --plugin typedoc-plugin-markdown --out docs/api ./host",
    "test": "npm run test:unit",
    "test:unit": "rm -rf dist-tests && tsc --project tsconfig.test.json && node --test \"dist-tests/host/**/*.test.js\"",
    "test:moddable": "node scripts/run-module-tests.js",
    "build": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcconfig -d -m -p \\$npm_config_target -t build \"$PWD/host/app/manifest_local.json\"",
    "build:m5stackchan_cores3": "mcconfig -d -m -p esp32:./host/platforms/m5stackchan_cores3 -t build \"$PWD/host/app/manifest_m5stackchan_cores3.json\"",
    "build:stackchan_rt": "mcconfig -d -m -p esp32:./host/platforms/stackchan_rt -t build \"$PWD/host/app/manifest_stackchan_rt.json\"",
    "build:lin": "mcconfig -d -m -p lin -t build \"$PWD/host/app/manifest_local.json\"",
    "smoke:lin": "bash scripts/smoke-lin.sh",
    "build:wasm": "mcconfig -d -m -p wasm -t build \"$PWD/host/app/manifest_wasm.json\" && mkdir -p ../web/simulator && cp $MODDABLE/build/bin/wasm/debug/app/mc.js $MODDABLE/build/bin/wasm/debug/app/mc.wasm ../web/simulator/",
    "bundle": "mcbundle -d -m \"$PWD/host/app/manifest.json\"",
    "deploy": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcconfig -d -m -p \\$npm_config_target -t deploy \"$PWD/host/app/manifest_local.json\"",
    "deploy:m5stackchan_cores3": "mcconfig -d -m -p esp32:./host/platforms/m5stackchan_cores3 -t deploy \"$PWD/host/app/manifest_m5stackchan_cores3.json\"",
    "deploy:stackchan_rt": "mcconfig -d -m -p esp32:./host/platforms/stackchan_rt -t deploy \"$PWD/host/app/manifest_stackchan_rt.json\"",
    "flash:m5stackchan_cores3": "npm run deploy:m5stackchan_cores3",
    "flash:stackchan_rt": "npm run deploy:stackchan_rt",
    "debug": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcconfig -d -m -p \\$npm_config_target \"$PWD/host/app/manifest_local.json\"",
    "debug:m5stackchan_cores3": "mcconfig -d -m -p esp32:./host/platforms/m5stackchan_cores3 \"$PWD/host/app/manifest_m5stackchan_cores3.json\"",
    "debug:stackchan_rt": "mcconfig -d -m -p esp32:./host/platforms/stackchan_rt \"$PWD/host/app/manifest_stackchan_rt.json\"",
    "mod": "cross-env npm_config_target?=esp32/m5stack cross-env-shell mcrun -d -m -p \\$npm_config_target",
    "mod:m5stackchan_cores3": "mcrun -d -m -p esp32:./host/platforms/m5stackchan_cores3",
    "mod:stackchan_rt": "mcrun -d -m -p esp32:./host/platforms/stackchan_rt",
    "setup": "xs-dev setup",
    "update": "xs-dev update",
    "doctor": "echo stack-chan environment info: && git rev-parse HEAD && git rev-parse --show-toplevel && xs-dev doctor",
    "scan": "xs-dev scan",
    "erase-flash": "esptool erase-flash",
    "install-hook": "lefthook install",
    "uninstall-hook": "lefthook uninstall"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/meganetaaan/stack-chan.git"
  },
  "keywords": [
    "M5Stack",
    "Robot",
    "Moddable",
    "Kawaii"
  ],
  "author": "Shinya Ishikawa",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/meganetaaan/stack-chan/issues"
  },
  "homepage": "https://github.com/meganetaaan/stack-chan#readme",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@microsoft/tsdoc": "^0.16.0",
    "@moddable/typings": "^8.3.0",
    "cross-env-default": "^5.1.3-1",
    "fontkit": "^2.0.2",
    "lefthook": "^2.1.9",
    "node-fetch": "^3.3.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "web-audio-engine": "^0.13.4",
    "xs-dev": "^1.12.1",
    "yargs": "^18.0.0"
  }
}
