+
+static void fixedOutLoop(void *pvParameter)
+{
+	AudioOut out = pvParameter;
+	for (;;) {
+		uint32_t state;
+		xTaskNotifyWait(0, UINT32_MAX, &state, portMAX_DELAY);
+		if (__atomic_load_n(&out->closing, __ATOMIC_ACQUIRE))
+			break;
+
+		while (__atomic_load_n(&out->started, __ATOMIC_ACQUIRE) && !__atomic_load_n(&out->closing, __ATOMIC_ACQUIRE)) {
+			AudioOutElement page;
+			uint32_t remaining = 0;
+			builtinCriticalSectionBegin();
+			for (page = out->started ? out->elements : NULL; page; page = page->next) {
+				remaining = __atomic_load_n(&page->bytesAvailable, __ATOMIC_ACQUIRE);
+				if (remaining) break;
+			}
+			if (page) __atomic_store_n(&out->fixedWriting, true, __ATOMIC_RELEASE);
+			builtinCriticalSectionEnd();
+			if (!page) break;
+
+			uint32_t size = (out->dma_buf_size < remaining) ? out->dma_buf_size : remaining;
+			page->err = doWrite(out, (uint8_t *)page->data + page->position, size);
+			page->position += size;
+			remaining = page->err ? 0 : remaining - size;
+			// A zero byte count releases the page to the machine's completion callback.
+			__atomic_store_n(&page->bytesAvailable, remaining, __ATOMIC_RELEASE);
+			if (!remaining)
+				__atomic_store_n(&out->completionReady, true, __ATOMIC_RELEASE);
+			__atomic_store_n(&out->fixedWriting, false, __ATOMIC_RELEASE);
+		}
+	}
+	out->task = NULL;
+	vTaskDelete(NULL);
+}
