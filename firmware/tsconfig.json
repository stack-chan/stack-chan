{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "module": "es2022",
    "lib": [
      "es2024"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "target": "es2024",
    "paths": {
      "face-context": [
        "./host/modules/ui/state/face-context"
      ],
      "face-skin": [
        "./host/modules/ui/state/face-skin"
      ],
      "app-controller": [
        "./host/modules/ui/application/app-controller"
      ],
      "chat-status-bar": [
        "./host/modules/ui/components/status-bar/chat-status-bar"
      ],
      "common-view": [
        "./host/modules/ui/views/main/common-view"
      ],
      "face-view": [
        "./host/modules/ui/views/main/face-view"
      ],
      "template": [
        "./host/modules/ui/components/face/template"
      ],
      "effects/*": [
        "./host/modules/ui/components/effects/*"
      ],
      "effects/speech-balloon": [
        "./host/modules/ui/components/bubble/speech-balloon"
      ],
      "effects/multirow-balloon": [
        "./host/modules/ui/components/bubble/multirow-balloon"
      ],
      "behaviors/*": [
        "./host/modules/ui/components/face/behaviors/*"
      ],
      "parts/*": [
        "./host/modules/ui/components/face/parts/*"
      ],
      "motions/*": [
        "./host/modules/ui/components/face/motions/*"
      ],
      "drawer": [
        "./host/modules/ui/components/drawer/drawer"
      ],
      "mocks/*": [
        "./tests/chats/mocks/*"
      ],
      "*": [
        "./node_modules/@moddable/typings/*",
        "./node_modules/@moddable/typings/ble/*",
        "./typings/*",
        "./stackchan/*",
        "./stackchan/ble/*",
        "./stackchan/default-mods/*",
        "./stackchan/dialogues/*",
        "./stackchan/drivers/*",
        "./stackchan/led/*",
        "./host/modules/ui/application/*",
        "./host/modules/ui/views/main/*",
        "./host/modules/ui/views/splash/*",
        "./host/modules/ui/views/camera-preview/*",
        "./host/modules/ui/components/status-bar/*",
        "./host/modules/ui/components/drawer/*",
        "./host/modules/ui/components/effects/*",
        "./host/modules/ui/components/bubble/*",
        "./host/modules/ui/components/face/*",
        "./host/modules/ui/components/face/behaviors/*",
        "./host/modules/ui/components/face/motions/*",
        "./host/modules/ui/components/face/parts/*",
        "./host/modules/ui/components/face/parts/dog/*",
        "./host/modules/ui/components/face/parts/image/*",
        "./host/modules/ui/state/*",
        "./stackchan/services/*",
        "./stackchan/speeches/*",
        "./stackchan/transcriptions/*",
        "./stackchan/utilities/*"
      ],
      "commodetto/*": [
        "./node_modules/@moddable/typings/commodetto/*"
      ],
      "dns/*": [
        "./node_modules/@moddable/typings/dns/*"
      ],
      "mc/*": [
        "./node_modules/@moddable/typings/mc/*"
      ],
      "mod/*": [
        "./node_modules/@moddable/typings/mod/*"
      ],
      "pins/*": [
        "./node_modules/@moddable/typings/pins/*"
      ],
      "piu/*": [
        "./node_modules/@moddable/typings/piu/*"
      ],
      "text/*": [
        "./node_modules/@moddable/typings/text/*"
      ],
      "embedded:provider/*": [
        "./node_modules/@moddable/typings/embedded_provider/*"
      ],
      "embedded:io/*": [
        "./node_modules/@moddable/typings/embedded_io/*"
      ],
      "embedded:io/audio/*": [
				"./node_modules/@moddable/typings/embedded_io/audio/*"
			],
      "embedded:io/bluetooth/*": [
				"./node_modules/@moddable/typings/embedded_io/bluetooth/*"
			],
      "embedded:io/socket/*": [
        "./node_modules/@moddable/typings/embedded_io/socket/*"
      ],
      "embedded:network/http/*": [
        "./node_modules/@moddable/typings/embedded_network/http/*"
      ],
      "embedded:network/interface/*": [
				"./node_modules/@moddable/typings/embedded_network/interface/*"
			],
      "embedded:network/mqtt/*": [
        "./node_modules/@moddable/typings/embedded_network/mqtt/*"
      ],
      "embedded:network/websocket/*": [
				"./node_modules/@moddable/typings/embedded_network/websocket/*"
			],
      "embedded:network/dns/resolver/*": [
        "./node_modules/@moddable/typings/embedded_network/dns/resolver/*"
      ],
      "default-mods/mod": [
        "./stackchan/default-mods/mod"
      ],
      "default-mods/on-launch": [
        "./stackchan/default-mods/on-launch"
      ],
      "calculate-power": [
        "./stackchan/speeches/calculate-power"
      ],
      "mac-address": [
        "./utilities/esp32/mac-address"
      ],
      "default-mods/on-robot-created": [
        "./stackchan/default-mods/on-robot-created"
      ],
      "mcp-client": [
        "./stackchan/services/mcp-client/mcp-client"
      ]
    },
    "types": [
      "./node_modules/@moddable/typings/xs",
      "./node_modules/@moddable/typings/mcpack",
      "./node_modules/@moddable/typings/easing"
    ]
  },
  "include": [
    "./stackchan/**/*",
    "./mods/**/*",
    "./tests/**/*"
  ]
}
