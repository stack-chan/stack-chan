{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "strictNullChecks": false,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "module": "es2022",
    "lib": [
      "es2024",
      "ESNext.Disposable"
    ],
    "outDir": "dist",
    "sourceMap": true,
    "target": "es2024",
    "paths": {
      "recording-wave": ["./host/modules/audio/recording-wave.ts"],
      "audio-ports": ["./host/modules/audio/audio-ports.ts"],
      "recorded-audio": ["./host/modules/audio/recorded-audio.ts"],
      "pcm-wave": ["./host/modules/audio/pcm-wave.ts"],
      "stackchan-result": ["./host/modules/util/result.ts"],
      "stackchan-contracts/*": ["./contracts/*.js"],
      "installed-mod": ["./host/modules/mod-package/installed-mod.ts"],
      "mod-maintenance": ["./host/modules/mod-package/mod-maintenance.ts"],
      "face-state": [
        "./host/modules/ui/state/face-state"
      ],
      "face-skin": [
        "./host/modules/ui/state/face-skin"
      ],
      "app-controller": [
        "./host/modules/ui/application/app-controller"
      ],
      "mini-app": [
        "./host/modules/ui/application/mini-app"
      ],
      "mini-app-launcher": [
        "./host/modules/ui/views/mini-app/mini-app-launcher"
      ],
      "capabilities": [
        "./host/app/capabilities"
      ],
      "motion-driver": [
        "./host/modules/motion/motion-driver"
      ],
      "runtime-context": [
        "./host/app/runtime-context"
      ],
      "camera-initial-frame": [
        "./host/modules/camera/device/initial-frame"
      ],
      "chat-audioio-config": [
        "./mods/examples/chat_audioio/config"
      ],
      "chat-status-bar": [
        "./host/modules/ui/components/status-bar/chat-status-bar"
      ],
      "common-view": [
        "./host/modules/ui/views/main/common-view"
      ],
      "face-view": [
        "./host/modules/ui/views/main/face-view"
      ],
      "hand-sprites": [
        "./host/modules/ui/components/hands/hand-sprites"
      ],
      "hands": [
        "./host/modules/ui/components/hands/hands"
      ],
      "settings-view": [
        "./host/modules/ui/views/settings/settings-view"
      ],
      "timezone-settings": [
        "./host/modules/preferences/timezone-settings"
      ],
      "timezone-model": [
        "./host/modules/preferences/timezone-model"
      ],
      "volume-model": [
        "./host/modules/preferences/volume-model"
      ],
      "volume-preview": [
        "./host/app/volume-preview"
      ],
      "localization": [
        "./host/modules/ui/localization"
      ],
      "localization-core": [
        "./host/modules/ui/localization-core"
      ],
      "template": [
        "./host/modules/ui/components/face/template"
      ],
      "effects/*": [
        "./host/modules/ui/components/effects/*"
      ],
      "effects/speech-balloon": [
        "./host/modules/ui/components/bubble/speech-balloon"
      ],
      "effects/multirow-balloon": [
        "./host/modules/ui/components/bubble/multirow-balloon"
      ],
      "behaviors/*": [
        "./host/modules/ui/components/face/behaviors/*"
      ],
      "parts/*": [
        "./host/modules/ui/components/face/parts/*"
      ],
      "motions/*": [
        "./host/modules/ui/components/face/motions/*"
      ],
      "drawer": [
        "./host/modules/ui/components/drawer/drawer"
      ],
      "image-avatar-lite-packs": [
        "./mods/examples/image_avatar_lite/image-avatar-lite-packs"
      ],
      "*": [
        "./node_modules/@moddable/typings/*",
        "./node_modules/@moddable/typings/ble/*",
        "./typings/*",
        "./host/app/*",
        "./host/modules/camera/*",
        "./host/modules/audio/*",
        "./host/modules/audio/wasm/*",
        "./host/modules/connectivity/*",
        "./host/modules/connectivity/ble/*",
        "./host/modules/connectivity/http-server/*",
        "./host/modules/connectivity/mcp-client/*",
        "./host/modules/connectivity/mcp-server/*",
        "./host/modules/connectivity/wasm/*",
        "./host/modules/conversation/*",
        "./host/modules/conversation/chat-audioio/*",
        "./host/modules/input/*",
        "./host/modules/motion/*",
        "./host/modules/motion/internal/*",
        "./host/modules/lighting/*",
        "./host/modules/ui/application/*",
        "./host/modules/ui/views/main/*",
        "./host/modules/ui/views/splash/*",
        "./host/modules/ui/views/camera-preview/*",
        "./host/modules/ui/views/settings/*",
        "./host/modules/ui/components/status-bar/*",
        "./host/modules/ui/components/drawer/*",
        "./host/modules/ui/components/effects/*",
        "./host/modules/ui/components/bubble/*",
        "./host/modules/ui/components/face/*",
        "./host/modules/ui/components/face/behaviors/*",
        "./host/modules/ui/components/face/motions/*",
        "./host/modules/ui/components/face/parts/*",
        "./host/modules/ui/components/face/parts/dog/*",
        "./host/modules/ui/components/face/parts/image/*",
        "./host/modules/ui/state/*",
        "./host/modules/input/*",
        "./host/modules/util/*",
        "./host/modules/util/esp32/*",
        "./host/modules/util/sim/*",
        "./host/modules/preferences/*",
        "./host/modules/power/*",
        "./host/modules/power/platforms/*"
      ],
      "commodetto/*": [
        "./node_modules/@moddable/typings/commodetto/*"
      ],
      "dns/*": [
        "./node_modules/@moddable/typings/dns/*"
      ],
      "mc/*": [
        "./node_modules/@moddable/typings/mc/*"
      ],
      "mod/*": [
        "./node_modules/@moddable/typings/mod/*"
      ],
      "pins/*": [
        "./node_modules/@moddable/typings/pins/*"
      ],
      "piu/*": [
        "./node_modules/@moddable/typings/piu/*"
      ],
      "text/*": [
        "./node_modules/@moddable/typings/text/*"
      ],
      "embedded:provider/*": [
        "./node_modules/@moddable/typings/embedded_provider/*"
      ],
      "embedded:io/*": [
        "./node_modules/@moddable/typings/embedded_io/*"
      ],
      "embedded:io/audio/*": [
        "./node_modules/@moddable/typings/embedded_io/audio/*"
      ],
      "embedded:io/bluetooth/*": [
        "./node_modules/@moddable/typings/embedded_io/bluetooth/*"
      ],
      "embedded:io/socket/*": [
        "./node_modules/@moddable/typings/embedded_io/socket/*"
      ],
      "embedded:network/http/*": [
        "./node_modules/@moddable/typings/embedded_network/http/*"
      ],
      "embedded:network/interface/*": [
        "./node_modules/@moddable/typings/embedded_network/interface/*"
      ],
      "embedded:network/mqtt/*": [
        "./node_modules/@moddable/typings/embedded_network/mqtt/*"
      ],
      "embedded:network/websocket/*": [
        "./node_modules/@moddable/typings/embedded_network/websocket/*"
      ],
      "embedded:network/dns/resolver/*": [
        "./node_modules/@moddable/typings/embedded_network/dns/resolver/*"
      ],
      "default-app/*": ["./host/app/default-app/*"],
      "testing/assert": [
        "./host/modules/testing/assert"
      ],
      "testing/fakes/ChatAudioIO": [
        "./host/modules/testing/fakes/ChatAudioIO"
      ],
      "calculate-power": [
        "./host/modules/audio/calculate-power"
      ],
      "mac-address": [
        "./host/modules/util/esp32/mac-address"
      ],
      "mcp-client": [
        "./host/modules/connectivity/mcp-client/mcp-client"
      ],
      "ecma-wifi": [
        "./host/modules/connectivity/ecma-wifi"
      ],
      "stackchan/*": [
        "./sdk/*.ts"
      ],
      "stackchan": [
        "./sdk/index.ts"
      ]
    },
    "types": [
      "./typings/xs-runtime",
      "./node_modules/@moddable/typings/mcpack",
      "./node_modules/@moddable/typings/easing"
    ]
  },
  "include": [
    "./host/**/*",
    "./mods/**/*"
  ]
}
