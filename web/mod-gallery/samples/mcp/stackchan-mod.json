{
  "$schema": "https://stack-chan.github.io/stack-chan/web/schemas/stackchan-mod.schema.json",
  "format": "tech.stackchan.mod",
  "schemaVersion": 2,
  "id": "tech.stackchan.samples.mcp-server",
  "version": "2.0.0",
  "type": "text",
  "name": "MCPサーバー",
  "description": "CodexなどのMCPクライアントから表情変更と発話を操作できるサーバーを起動し、接続先URLをドロワーから確認できます。Wi-Fiとmcp.tokenの設定が必要です。",
  "author": "Stack-chan Community",
  "license": "Apache-2.0",
  "source": {
    "path": "source/manifest.json",
    "entrypoint": "source/mod.ts"
  },
  "targets": [
    "m5stackchan-cores3"
  ],
  "capabilities": [
    "ui.controls",
    "network.http",
    "audio.speech",
    "settings"
  ],
  "artifacts": [
    {
      "format": "xsa",
      "path": "mcp.xsa",
      "target": "m5stackchan-cores3"
    }
  ],
  "appApiVersion": 2,
  "hostApiVersion": 7,
  "optionalCapabilities": [
    "network.http",
    "audio.speech",
    "settings"
  ],
  "entrypoints": [
    "mod"
  ]
}
