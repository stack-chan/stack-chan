{
  "$schema": "https://stack-chan.github.io/stack-chan/web/schemas/stackchan-mod.schema.json",
  "format": "tech.stackchan.mod",
  "schemaVersion": 2,
  "id": "tech.stackchan.samples.mediapipe-ble",
  "version": "2.0.0",
  "type": "text",
  "name": "MediaPipe BLE追従",
  "description": "PCのカメラで認識した顔向き、表情、左右の目と口の開き、顔に対する手の位置、手の向きと指の本数をBLEで受信して再現します。BLE Serial対応ファームウェアが必要です。",
  "author": "Stack-chan Community",
  "license": "Apache-2.0",
  "source": {
    "path": "source/manifest.json",
    "entrypoint": "source/mod.ts"
  },
  "targets": [
    "m5stackchan-cores3"
  ],
  "capabilities": [
    "ui.controls",
    "network.peer",
    "motion"
  ],
  "artifacts": [
    {
      "format": "xsa",
      "path": "mediapipe-ble.xsa",
      "target": "m5stackchan-cores3"
    }
  ],
  "appApiVersion": 2,
  "hostApiVersion": 7,
  "optionalCapabilities": [
    "network.peer",
    "motion"
  ],
  "entrypoints": [
    "mod"
  ]
}
