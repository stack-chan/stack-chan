{
  "$schema": "https://stack-chan.github.io/stack-chan/web/schemas/stackchan-mod.schema.json",
  "format": "tech.stackchan.mod",
  "schemaVersion": 2,
  "id": "sample.stackchan-minigames",
  "version": "2.0.0",
  "type": "text",
  "name": "ｽﾀｯｸﾁｬﾝ ミニゲーム集",
  "description": "1つのMODでJUMPとCATCHを収録。障害物を飛び越えるアクションと、アイテムを集めて爆弾を避けるゲーム&ウォッチ風ゲームを遊べます。",
  "author": "Stack-chan Community",
  "license": "Apache-2.0 AND MIT",
  "source": {
    "path": "source/manifest.json",
    "entrypoint": "source/mod.ts"
  },
  "entrypoints": ["mod"],
  "targets": ["m5stackchan-cores3", "simulator"],
  "capabilities": ["ui.piu"],
  "artifacts": [
    {
      "format": "xsa",
      "path": "stackchan-minigames.xsa",
      "target": "m5stackchan-cores3"
    }
  ],
  "appApiVersion": 2,
  "hostApiVersion": 3
}
