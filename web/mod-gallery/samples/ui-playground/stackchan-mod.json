{
  "$schema": "https://stack-chan.github.io/stack-chan/web/schemas/stackchan-mod.schema.json",
  "format": "tech.stackchan.mod",
  "schemaVersion": 2,
  "id": "tech.stackchan.samples.ui-playground",
  "version": "2.0.0",
  "type": "text",
  "name": "UI Playground",
  "description": "Piuの選択肢、区切り線、ヘルプ、通知を試せるミニアプリです。本体のAppBarから起動します。",
  "author": "Stack-chan Community",
  "license": "Apache-2.0",
  "source": {
    "path": "source/manifest.json",
    "entrypoint": "source/mod.ts"
  },
  "entrypoints": ["mod"],
  "targets": ["m5stackchan-cores3", "simulator"],
  "capabilities": ["ui.piu"],
  "artifacts": [
    {
      "format": "xsa",
      "path": "ui-playground.xsa",
      "target": "m5stackchan-cores3"
    }
  ],
  "appApiVersion": 2,
  "hostApiVersion": 3
}
