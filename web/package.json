{
  "name": "stackchan-web",
  "version": "1.1.0",
  "type": "module",
  "description": "Stack-chan browser tools",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:legacy && npm run test:react",
    "test:legacy": "node --test simulator/*.test.mjs editor/*.test.mjs face-editor/*.test.mjs mediapipe/*.test.mjs mod-gallery/*.test.mjs local-peer/*.test.mjs *.test.mjs",
    "test:react": "vitest run",
    "test:i18n-visual": "npm run build && node i18n-visual-test.mjs",
    "check:editor-artifacts": "node check-editor-artifacts.mjs",
    "test:visual": "npm run build && node visual-pages-test.mjs && node simulator/visual-test.mjs",
    "metrics:aggregate": "node editor/aggregate-metrics-cli.mjs"
  },
  "keywords": [],
  "author": "Shinya Ishikawa",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "blockly": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esptool-js": "0.6.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^27.4.0",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
